{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lift-RS configuration catalogue, version 1",
  "description": "Structural validation. The Go loader additionally checks dimensions, polynomial irreducibility, rate, intervals, and query arithmetic.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "construction": {
      "const": "curve-lifted-rs-qminus1"
    },
    "configurations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configuration"
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "construction",
    "configurations"
  ],
  "additionalProperties": false,
  "$defs": {
    "configuration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "encoding_status": {
          "enum": [
            "candidate",
            "supported"
          ]
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "capacity": {
          "$ref": "#/$defs/capacity"
        },
        "query": {
          "$ref": "#/$defs/query"
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "encoder": {
          "$ref": "#/$defs/encoder"
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "encoding_status",
        "code",
        "capacity",
        "query",
        "security"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding_status": {
                "const": "supported"
              }
            }
          },
          "then": {
            "required": [
              "encoder"
            ],
            "properties": {
              "capacity": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                }
              },
              "code": {
                "required": [
                  "polynomial"
                ]
              }
            }
          }
        }
      ]
    },
    "code": {
      "type": "object",
      "properties": {
        "s": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "m": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3
        },
        "t": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048574
        },
        "polynomial": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097151
        }
      },
      "required": [
        "s",
        "m",
        "t"
      ],
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "estimated",
            "verified"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "n"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "k"
                  ]
                },
                {
                  "required": [
                    "rate"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "k",
              "rate",
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "encoding",
                        "reference_test"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "properties": {
        "curve_positions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "dummy_positions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "dummy_rule": {
          "const": "fixed_count_uniform_positions"
        }
      },
      "required": [
        "curve_positions",
        "dummy_positions",
        "length",
        "dummy_rule"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "computational_bits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "log2_samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "assumptions": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "computational_bits",
        "log2_samples",
        "assumptions",
        "evidence"
      ],
      "additionalProperties": false
    },
    "encoder": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "preprocessing": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "implementation",
        "preprocessing",
        "evidence"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "paper",
            "analytical",
            "monte_carlo",
            "encoding",
            "reference_test",
            "measurement"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "monte_carlo": {
          "$ref": "#/$defs/monteCarlo"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "analytical",
                  "monte_carlo",
                  "encoding",
                  "measurement"
                ]
              }
            }
          },
          "then": {
            "required": [
              "script",
              "results"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "monte_carlo"
              }
            }
          },
          "then": {
            "required": [
              "method",
              "monte_carlo"
            ]
          },
          "else": {
            "not": {
              "required": [
                "monte_carlo"
              ]
            }
          }
        }
      ]
    },
    "monteCarlo": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "lower_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "samples",
        "confidence",
        "lower_rate",
        "upper_rate"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "stage": {
          "enum": [
            "code_preprocessing",
            "database_encoding"
          ]
        },
        "quantity": {
          "enum": [
            "elapsed_seconds",
            "peak_bytes",
            "artifact_bytes",
            "stored_bytes"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "evidence": {
          "allOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "properties": {
                "kind": {
                  "const": "measurement"
                }
              }
            }
          ]
        }
      },
      "required": [
        "stage",
        "quantity",
        "value",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
